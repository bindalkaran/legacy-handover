# Neon Postgres connection string (set automatically by the Vercel Neon integration)
DATABASE_URL=
# Long random string used to sign session cookies (falls back to a hash of DATABASE_URL)
SESSION_SECRET=
# Passphrase for the /admin console. Admin is disabled until this is set.
ADMIN_PASSWORD=
# Phone sign-in via Firebase Phone Auth (web app config from the Firebase console).
# Add every domain you serve from (legacyhandover.com, www.legacyhandover.com, legacy-handover.vercel.app) under Authentication > Settings > Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Optional alternatives: email OTP via Resend, SMS OTP via MSG91.
RESEND_API_KEY=
OTP_FROM_EMAIL=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Testing only: show sign-in codes on screen in production. Remove before launch.
OTP_PREVIEW=
# Razorpay. Webhook URL: https://<your-domain>/api/razorpay/webhook (events: payment.captured, order.paid, payment.failed, refund.processed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Testing only: unlock the paid report free in production. Remove before launch.
PAYMENTS_TEST_MODE=
# Optional: Anthropic key for AI-written report narrative. Deterministic fallback otherwise.
ANTHROPIC_API_KEY=
